{
	"name": "portfolio",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome lint src/app src/components/portfolio src/data/site-content.ts src/lib",
		"typecheck": "tsc --noEmit",
		"format:check": "prettier --check \"src/app/**/*.{ts,tsx,css}\" \"src/components/portfolio/**/*.{ts,tsx}\" \"src/data/site-content.ts\" \"src/lib/**/*.ts\" package.json",
		"check": "npm run format:check && npm run lint && npm run typecheck && npm run build"
	},
	"engines": {
		"node": "24.x"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"lucide-react": "^1.34.0",
		"motion": "^13.1.1",
		"next": "16.3.3",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"tailwind-merge": "^3.6.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"@tailwindcss/postcss": "^4.3.3",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/node": "^26.3.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"prettier": "^3.9.6",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3"
	}
}
